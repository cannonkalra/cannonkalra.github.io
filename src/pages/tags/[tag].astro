---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";
import { getTags, getPostsByTag, slugify } from "@/lib/posts";

export const getStaticPaths = (async () => {
  const tags = await getTags();
  return Promise.all(
    tags.map(async ({ tag }) => ({
      params: { tag: slugify(tag) },
      props: { tag, posts: await getPostsByTag(tag) },
    })),
  );
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag}`}
  description={`Articles tagged “${tag}”.`}
>
  <header class="pt-14">
    <a
      href="/tags"
      class="inline-flex items-center gap-1.5 font-sans text-sm text-muted transition-colors hover:text-text"
    >
      <Icon name="arrowLeft" size={15} /> All tags
    </a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-text sm:text-4xl">
      <span class="text-faint">#</span>{tag}
    </h1>
    <p class="mt-3 text-muted">
      {posts.length} article{posts.length === 1 ? "" : "s"}
    </p>
  </header>

  <div class="mt-8">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
