---
import { SITE } from "@/config";
import BaseHead from "@/components/BaseHead.astro";
import ThemeScript from "@/components/ThemeScript.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Search from "@/components/Search.astro";
import Analytics from "@/components/Analytics.astro";

/** Props are forwarded verbatim to <BaseHead> for SEO. */
interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  canonical?: string;
  noindex?: boolean;
  /** Constrain <main>; article pages opt out to control their own width. */
  wide?: boolean;
}
const { wide = false, ...head } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <ThemeScript />
    <BaseHead {...head} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Header />

    <main
      id="main"
      class:list={[
        "mx-auto w-full px-5",
        wide ? "max-w-5xl" : "max-w-2xl",
      ]}
    >
      <slot />
    </main>

    <Footer />
    <Search />
    <Analytics />
  </body>
</html>
