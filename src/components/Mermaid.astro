---
/**
 * Explicit Mermaid diagram for MDX authors who want a caption:
 *   <Mermaid code={`graph TD; A-->B;`} title="Flow" />
 *
 * Rendering is handled globally by MermaidScript.astro (included in PostLayout),
 * which also upgrades plain ```mermaid fences. This component only emits the
 * placeholder markup.
 */
interface Props {
  code: string;
  title?: string;
}
const { code, title } = Astro.props;
---

<figure class="mermaid-figure my-8 full-bleed">
  <div
    class="mermaid grid min-h-24 place-items-center overflow-x-auto rounded-lg border border-border bg-bg-subtle p-4"
    data-mermaid={code}
  >
    <span class="font-sans text-sm text-faint">Rendering diagram…</span>
  </div>
  {
    title && (
      <figcaption class="mt-2 text-center font-sans text-sm text-faint">
        {title}
      </figcaption>
    )
  }
</figure>
