---
import type { Post } from "@/lib/posts";
import Icon from "./Icon.astro";

interface Props {
  seriesName: string;
  posts: Post[];
  currentId: string;
}
const { seriesName, posts, currentId } = Astro.props;
const currentIndex = posts.findIndex((p) => p.id === currentId);
---

<aside
  class="my-8 rounded-xl border border-border bg-bg-subtle p-5"
  aria-label={`Series: ${seriesName}`}
>
  <p class="flex items-center gap-2 font-sans text-sm font-semibold text-text">
    <Icon name="layers" size={16} />
    <span>
      This is part {currentIndex + 1} of the series
      <span class="text-accent">{seriesName}</span>
    </span>
  </p>
  <ol class="mt-3 space-y-1.5">
    {
      posts.map((p, i) => (
        <li class="flex items-start gap-2.5 text-sm">
          <span
            class:list={[
              "mt-0.5 grid size-5 shrink-0 place-items-center rounded-full text-xs",
              p.id === currentId
                ? "bg-accent text-white"
                : "bg-surface text-faint",
            ]}
          >
            {i + 1}
          </span>
          {p.id === currentId ? (
            <span class="font-medium text-text">{p.data.title}</span>
          ) : (
            <a
              href={`/blog/${p.id}/`}
              class="text-muted underline-offset-2 hover:text-text hover:underline"
            >
              {p.data.title}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</aside>
