---
import { NAV_LINKS } from "@/config";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur-md"
  data-pagefind-ignore
>
  <nav
    class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5"
    aria-label="Primary"
  >
    <a
      href="/"
      class="font-mono text-sm font-medium tracking-tight text-text transition-opacity hover:opacity-70"
    >
      cannon<span class="text-accent">.</span>kalra
    </a>

    <div class="flex items-center gap-1">
      <ul class="mr-1 hidden items-center gap-1 sm:flex">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "rounded-md px-3 py-2 text-sm transition-colors hover:text-text",
                  isActive(link.href) ? "text-text" : "text-muted",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="search-open"
        type="button"
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:bg-bg-subtle hover:text-text"
        aria-label="Search"
        title="Search (press /)"
      >
        <Icon name="search" size={18} />
      </button>

      <ThemeToggle />

      <button
        id="menu-open"
        type="button"
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:bg-bg-subtle hover:text-text sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    hidden
    class="border-t border-border bg-bg px-5 py-3 sm:hidden"
  >
    <ul class="flex flex-col gap-1">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-2.5 text-base transition-colors hover:bg-bg-subtle",
                isActive(link.href) ? "text-text" : "text-muted",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById("menu-open");
  const menu = document.getElementById("mobile-menu");
  menuBtn?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden");
    if (open) menu?.removeAttribute("hidden");
    else menu?.setAttribute("hidden", "");
    menuBtn.setAttribute("aria-expanded", String(open));
  });
</script>
