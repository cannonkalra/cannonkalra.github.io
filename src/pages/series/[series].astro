---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Icon from "@/components/Icon.astro";
import { getSeries } from "@/lib/posts";

export const getStaticPaths = (async () => {
  const series = await getSeries();
  return series.map((s) => ({
    params: { series: s.slug },
    props: { series: s },
  }));
}) satisfies GetStaticPaths;

const { series } = Astro.props;
---

<BaseLayout
  title={series.name}
  description={`A ${series.posts.length}-part series.`}
>
  <header class="pt-14">
    <a
      href="/series"
      class="inline-flex items-center gap-1.5 font-sans text-sm text-muted transition-colors hover:text-text"
    >
      <Icon name="arrowLeft" size={15} /> All series
    </a>
    <p class="mt-4 flex items-center gap-2 font-sans text-sm font-medium text-accent">
      <Icon name="layers" size={16} /> Series
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-text sm:text-4xl">
      {series.name}
    </h1>
    <p class="mt-3 text-muted">
      {series.posts.length} parts, in reading order.
    </p>
  </header>

  <div class="mt-8">
    {series.posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
