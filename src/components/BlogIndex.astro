---
import type { Post } from "@/lib/posts";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";

interface Props {
  posts: Post[];
  currentPage: number;
  lastPage: number;
  urlPrev?: string;
  urlNext?: string;
}
const { posts, currentPage, lastPage, urlPrev, urlNext } = Astro.props;
---

<header class="pt-14">
  <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
    Writing
  </h1>
  <p class="mt-3 text-lg text-muted">
    Essays on data platforms, distributed systems, and building software that
    lasts.
  </p>
</header>

<div class="mt-8">
  {posts.map((post) => <PostCard post={post} />)}
</div>

<Pagination
  currentPage={currentPage}
  lastPage={lastPage}
  urlPrev={urlPrev}
  urlNext={urlNext}
/>
