---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { getSeries } from "@/lib/posts";
import { formatDate } from "@/lib/format";

const series = await getSeries();
---

<BaseLayout
  title="Series"
  description="Multi-part deep dives, read in order."
>
  <header class="pt-14">
    <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
      Series
    </h1>
    <p class="mt-3 text-lg text-muted">
      Multi-part deep dives, meant to be read in order.
    </p>
  </header>

  <div class="mt-10 space-y-10">
    {
      series.map((s) => (
        <section>
          <div class="flex items-center gap-2">
            <Icon name="layers" size={18} class="text-accent" />
            <h2 class="text-xl font-semibold text-text">
              <a href={`/series/${s.slug}`} class="hover:text-accent">
                {s.name}
              </a>
            </h2>
            <span class="text-sm text-faint">{s.posts.length} parts</span>
          </div>
          <ol class="mt-3 divide-y divide-border rounded-lg border border-border">
            {s.posts.map((p, i) => (
              <li>
                <a
                  href={`/blog/${p.id}/`}
                  class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-bg-subtle"
                >
                  <span class="grid size-6 shrink-0 place-items-center rounded-full bg-bg-subtle font-sans text-xs text-faint">
                    {i + 1}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-medium text-text">
                      {p.data.title}
                    </span>
                    <span class="text-sm text-faint">
                      {formatDate(p.data.pubDate)}
                    </span>
                  </span>
                  <Icon name="arrowRight" size={15} class="text-faint" />
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {series.length === 0 && <p class="text-muted">No series yet.</p>}
  </div>
</BaseLayout>
