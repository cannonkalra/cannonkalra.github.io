---
import { slugify } from "@/lib/posts";
interface Props {
  tag: string;
  count?: number;
  active?: boolean;
}
const { tag, count, active = false } = Astro.props;
---
<a
  href={`/tags/${slugify(tag)}`}
  aria-current={active ? "page" : undefined}
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-sans text-xs transition-colors",
    active
      ? "border-accent bg-accent-soft text-accent"
      : "border-border bg-bg-subtle text-muted hover:border-border-strong hover:text-text",
  ]}
>
  <span class="text-faint">#</span>{tag}
  {count !== undefined && <span class="text-faint">{count}</span>}
</a>
