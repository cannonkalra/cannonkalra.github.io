---
/** A slim top-of-viewport bar tracking scroll through the article body. */
---
<div
  class="fixed inset-x-0 top-0 z-50 h-0.5 bg-transparent"
  aria-hidden="true"
>
  <div
    id="reading-progress"
    class="h-full origin-left scale-x-0 bg-accent transition-transform duration-75 ease-out"
  >
  </div>
</div>

<script>
  const bar = document.getElementById("reading-progress");
  const article = document.querySelector("article");
  if (bar && article) {
    const update = () => {
      const { top, height } = article.getBoundingClientRect();
      const total = height - window.innerHeight;
      const progress = total <= 0 ? 1 : Math.min(1, Math.max(0, -top / total));
      bar.style.transform = `scaleX(${progress})`;
    };
    update();
    document.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>
