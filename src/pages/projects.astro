---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import { PROJECTS } from "@/lib/projects";
---

<BaseLayout
  title="Projects"
  description="Selected work in data platforms and distributed systems."
>
  <header class="pt-14">
    <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
      Projects
    </h1>
    <p class="mt-3 text-lg text-muted">
      Selected work in data platforms and distributed systems.
    </p>
  </header>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      PROJECTS.map((p) => (
        <article class="flex flex-col rounded-xl border border-border bg-surface p-5 transition-colors hover:border-border-strong">
          <h2 class="flex items-center justify-between gap-2 text-lg font-semibold text-text">
            {p.name}
            {p.href && (
              <a href={p.href} aria-label={`Visit ${p.name}`} class="text-faint hover:text-accent">
                <Icon name="arrowUpRight" size={18} />
              </a>
            )}
          </h2>
          <p class="mt-2 flex-1 text-sm text-muted">{p.summary}</p>
          <ul class="mt-4 flex flex-wrap gap-1.5">
            {p.tags.map((t) => (
              <li class="rounded-full bg-bg-subtle px-2.5 py-1 font-mono text-xs text-faint">
                {t}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</BaseLayout>
