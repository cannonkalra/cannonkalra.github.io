---
import type { Post } from "@/lib/posts";
import { readingTime } from "@/lib/posts";
import PostMeta from "./PostMeta.astro";
import Icon from "./Icon.astro";

interface Props {
  post: Post;
  /** Larger, lead treatment for the top of a list. */
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, description, pubDate, updatedDate, series } = post.data;
---

<article
  class:list={[
    "group relative border-b border-border py-8 first:pt-0",
    featured && "sm:py-10",
  ]}
>
  {
    series && (
      <p class="mb-2 font-sans text-xs font-medium uppercase tracking-wider text-accent">
        {series.name} · Part {series.order}
      </p>
    )
  }

  <h2
    class:list={[
      "font-semibold tracking-tight text-text",
      featured ? "text-2xl sm:text-3xl" : "text-xl",
    ]}
  >
    <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">
      {title}
    </a>
  </h2>

  <p class="mt-2 max-w-prose text-muted">{description}</p>

  <div class="mt-3 flex items-center justify-between">
    <PostMeta date={pubDate} updated={updatedDate} minutes={readingTime(post)} />
    <span
      class="hidden items-center gap-1 text-sm text-accent opacity-0 transition-opacity group-hover:opacity-100 sm:inline-flex"
    >
      Read <Icon name="arrowRight" size={15} />
    </span>
  </div>
</article>
