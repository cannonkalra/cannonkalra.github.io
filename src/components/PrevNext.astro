---
import type { Post } from "@/lib/posts";
import Icon from "./Icon.astro";

interface Props {
  prev?: Post;
  next?: Post;
}
const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav
      class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2"
      aria-label="Adjacent articles"
    >
      {prev ? (
        <a
          href={`/blog/${prev.id}/`}
          class="group rounded-lg border border-border p-4 transition-colors hover:border-border-strong hover:bg-bg-subtle"
        >
          <span class="flex items-center gap-1.5 font-sans text-xs text-muted">
            <Icon name="arrowLeft" size={14} /> Older
          </span>
          <span class="mt-1 block font-medium text-text group-hover:text-accent">
            {prev.data.title}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={`/blog/${next.id}/`}
          class="group rounded-lg border border-border p-4 text-right transition-colors hover:border-border-strong hover:bg-bg-subtle"
        >
          <span class="flex items-center justify-end gap-1.5 font-sans text-xs text-muted">
            Newer <Icon name="arrowRight" size={14} />
          </span>
          <span class="mt-1 block font-medium text-text group-hover:text-accent">
            {next.data.title}
          </span>
        </a>
      )}
    </nav>
  )
}
